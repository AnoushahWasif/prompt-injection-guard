# Override where raw data is stored (default: data/raw).
GUARD_DATA_DIR=data/raw

# --- Guard API (python -m uvicorn --factory guard.api:app_from_env) ---
GUARD_MODEL_DIR=models/portable
# SHA-256 of models/portable/manifest.json, from deploy config, not from the model folder:
# someone who can swap the model can usually edit files next to it too. `make baseline`
# prints it after training; check it in review.
GUARD_MODEL_SHA256=
# Comma-separated SHA-256 hashes of the API keys, never the keys themselves. Make one with:
#   python -c "import hashlib,secrets; k=secrets.token_urlsafe(32); print(k); print(hashlib.sha256(k.encode()).hexdigest())"
GUARD_API_KEY_SHA256=
GUARD_RATE_PER_MINUTE=120
GUARD_MAX_CONCURRENT=4
GUARD_TIMEOUT_SECONDS=2.0
